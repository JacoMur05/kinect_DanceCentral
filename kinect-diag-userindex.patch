 dword_result_t XamUserNuiGetUserIndex_entry(unknown_t unk, lpdword_t index) {
-  return X_E_NO_SUCH_USER;
+  // EXPERIMENT (Dance Central 545607D3 imports this): it always failed with
+  // X_E_NO_SUCH_USER, so the title may never bind a tracked skeleton to a
+  // signed-in user. Log the arguments and bind to the first signed-in profile,
+  // like XamUserNuiGetUserIndexForSignin does.
+  static std::atomic<uint32_t> calls{0};
+  const uint32_t call = calls.fetch_add(1);
+  uint32_t result = X_E_NO_SUCH_USER;
+  if (index) {
+    for (uint32_t i = 0; i < XUserMaxUserCount; i++) {
+      if (kernel_state()->xam_state()->GetUserProfile(i)) {
+        *index = i;
+        result = X_E_SUCCESS;
+        break;
+      }
+    }
+  }
+  if (call < 6) {
+    XELOGI("Kinect diag: XamUserNuiGetUserIndex(unk={:08X}) -> {:08X} index={}",
+           static_cast<uint32_t>(unk), result,
+           index ? static_cast<uint32_t>(*index) : 0xFFFFFFFFu);
+  }
+  return result;
 }
 DECLARE_XAM_EXPORT1(XamUserNuiGetUserIndex, kNone, kStub);
 
