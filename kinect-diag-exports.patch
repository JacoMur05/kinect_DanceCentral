diff --git a/src/xenia/gpu/d3d12/d3d12_command_processor.cc b/src/xenia/gpu/d3d12/d3d12_command_processor.cc
index ddf7f97..79d5477 100644
--- a/src/xenia/gpu/d3d12/d3d12_command_processor.cc
+++ b/src/xenia/gpu/d3d12/d3d12_command_processor.cc
@@ -9,7 +9,9 @@
 
 #include "xenia/gpu/d3d12/d3d12_command_processor.h"
 #include <chrono>
+#include <cstdio>
 #include <cstring>
+#include <string>
 #include "xenia/apu/audio_system.h"
 #include "xenia/base/assert.h"
 #include "xenia/base/byte_order.h"
@@ -3291,6 +3293,76 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type,
                 std::memcpy(memory_->TranslatePhysical(
                                 memexport_range.base_address_dwords << 2),
                             readback_bytes, memexport_range.size_bytes);
+                {
+                  // DIAGNOSTIC: once per 3 s window, log each distinct
+                  // exported range (address, size) with simple statistics of
+                  // its contents, to see what the title's GPU work produces.
+                  static uint32_t diag_seen[16];
+                  static uint32_t diag_seen_count = 0;
+                  static std::chrono::steady_clock::time_point
+                      diag_range_window = std::chrono::steady_clock::now();
+                  const auto diag_range_now = std::chrono::steady_clock::now();
+                  if (diag_range_now - diag_range_window >=
+                      std::chrono::seconds(3)) {
+                    diag_range_window = diag_range_now;
+                    diag_seen_count = 0;
+                  }
+                  const uint32_t range_address =
+                      memexport_range.base_address_dwords << 2;
+                  bool already_seen = false;
+                  for (uint32_t i = 0; i < diag_seen_count; ++i) {
+                    if (diag_seen[i] == range_address) {
+                      already_seen = true;
+                      break;
+                    }
+                  }
+                  if (!already_seen && diag_seen_count < 16) {
+                    diag_seen[diag_seen_count++] = range_address;
+                    uint32_t histogram[256] = {};
+                    for (uint32_t i = 0; i < memexport_range.size_bytes; ++i) {
+                      ++histogram[readback_bytes[i]];
+                    }
+                    uint32_t distinct = 0;
+                    for (uint32_t value = 0; value < 256; ++value) {
+                      if (histogram[value]) {
+                        ++distinct;
+                      }
+                    }
+                    uint32_t top[3] = {0, 0, 0};
+                    bool used[256] = {};
+                    for (uint32_t k = 0; k < 3; ++k) {
+                      uint32_t best = 256;
+                      for (uint32_t value = 0; value < 256; ++value) {
+                        if (!used[value] &&
+                            (best == 256 || histogram[value] > histogram[best])) {
+                          best = value;
+                        }
+                      }
+                      used[best] = true;
+                      top[k] = best;
+                    }
+                    std::string first;
+                    for (uint32_t i = 0;
+                         i < 32 && i < memexport_range.size_bytes; ++i) {
+                      char text[8];
+                      std::snprintf(text, sizeof(text), "%02X",
+                                    static_cast<unsigned>(readback_bytes[i]));
+                      first += text;
+                    }
+                    const uint64_t size = memexport_range.size_bytes;
+                    XELOGI(
+                        "GPU diag: export addr={:08X} size={} ranges_in_draw={} "
+                        "zero_bytes={}% distinct_values={} top_values "
+                        "{:02X}:{}% {:02X}:{}% {:02X}:{}% first32={}",
+                        range_address, memexport_range.size_bytes,
+                        memexport_ranges_.size(),
+                        size ? histogram[0] * 100ull / size : 0, distinct,
+                        top[0], size ? histogram[top[0]] * 100ull / size : 0,
+                        top[1], size ? histogram[top[1]] * 100ull / size : 0,
+                        top[2], size ? histogram[top[2]] * 100ull / size : 0,
+                        first);
+                  }
+                }
                 readback_bytes += memexport_range.size_bytes;
               }
               D3D12_RANGE readback_write_range = {};
