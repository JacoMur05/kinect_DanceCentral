+// DIAGNOSTIC: raw big-endian words of guest memory, for reading what the title
+// passes to the tilt functions (and the title's own callback code).
+static std::string NuiDiagGuestWords(uint32_t address, uint32_t count) {
+  Memory* memory = kernel_state()->memory();
+  if (!address || !memory->LookupHeap(address) ||
+      !memory->LookupHeap(address + count * 4 - 1)) {
+    return "(not readable)";
+  }
+  const uint8_t* data = memory->TranslateVirtual<const uint8_t*>(address);
+  std::string text;
+  for (uint32_t i = 0; i < count; ++i) {
+    char word[16];
+    std::snprintf(word, sizeof(word), "%08X ",
+                  static_cast<unsigned>(xe::load_and_swap<uint32_t>(data + i * 4)));
+    text += word;
+  }
+  return text;
+}
