+dword_result_t XamNuiCameraTiltSetCallback_entry(dword_t callback, dword_t context,
+                                                 dword_t flags) {
+  static std::atomic<uint32_t> calls{0};
+  if (calls.fetch_add(1) < 2) {
+    XELOGI("Kinect diag: XamNuiCameraTiltSetCallback(fn={:08X}, ctx={:08X}, {:08X})",
+           static_cast<uint32_t>(callback), static_cast<uint32_t>(context),
+           static_cast<uint32_t>(flags));
+    XELOGI("Kinect diag: callback code @{:08X}: {}",
+           static_cast<uint32_t>(callback),
+           NuiDiagGuestWords(callback, 64));
+  }
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamNuiCameraTiltSetCallback, kNone, kStub);
+
+dword_result_t XamNuiCameraElevationSetAngle_entry(dword_t angle, dword_t pointer,
