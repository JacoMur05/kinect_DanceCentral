+           static_cast<int32_t>(angle), static_cast<uint32_t>(pointer),
+           static_cast<uint32_t>(size));
+    XELOGI("Kinect diag: SetAngle ptr words @{:08X}: {}",
+           static_cast<uint32_t>(pointer), NuiDiagGuestWords(pointer, 12));
+  }
+  return X_ERROR_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamNuiCameraElevationSetAngle, kNone, kStub);
